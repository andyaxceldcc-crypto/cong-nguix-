        proxy_pass https://lkhjerbhye3wjkhodvh5xiczuvd.lol/stream/Vq8h-mG2CzgXOkXyEzvm9w/hjkrhuihghfvu/1791431876/43357069/index-f2-v1-a1.m3u8;

        proxy_set_header Host lkhjerbhye3wjkhodvh5xiczuvd.lol;
